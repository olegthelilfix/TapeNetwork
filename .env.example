# Postgres
POSTGRES_DB=tape
POSTGRES_USER=tape
POSTGRES_PASSWORD=tape
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tape
SPRING_DATASOURCE_USERNAME=tape
SPRING_DATASOURCE_PASSWORD=tape
# JWT secret for CMS admin auth (change in real environments)
JWT_SECRET=dev-secret-change-me-please-32bytes-min
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Local dir (inside container) where Hibernate Search Lucene indexes live
SEARCH_INDEX_DIR=/var/lib/tape/search
# Local dir (inside container) where uploaded media files are stored (served at /uploads/**)
MEDIA_DIR=/var/lib/tape/media

# Web (Next.js)
WEB_PORT=3000
# Server-side base URL (container-to-container)
API_BASE_URL=http://backend:8080
# Browser-side base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Public site origin — used for canonical URLs, OpenGraph, sitemap.xml (set to real domain in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-side base URL of the tape-streamer HLS service (used to build stream playlist URLs)
NEXT_PUBLIC_STREAMER_URL=http://localhost:8082

# Streamer (tape-streamer HLS service)
STREAMER_PORT=8082

# CMS (Refine)
CMS_PORT=5173
VITE_ADMIN_API_URL=http://localhost:8080/api/admin
