# Reference for the .env the deploy workflow generates on the VM.
# Do NOT commit a filled-in copy — secrets belong in GitHub Actions secrets.

# Image refs (the workflow sets these to the pushed :<git-sha> tags)
BACKEND_IMAGE=europe-west4-docker.pkg.dev/PROJECT/tape/backend:latest
WEB_IMAGE=europe-west4-docker.pkg.dev/PROJECT/tape/web:latest
CMS_IMAGE=europe-west4-docker.pkg.dev/PROJECT/tape/cms:latest
STREAMER_IMAGE=ghcr.io/olegthelilfix/tape-streamer:latest

# Streamer video source + HLS cache dirs on the host (bind-mounted into the container)
VIDEOS_HOST_DIR=/home/oaleksandrov/videos
HLS_CACHE_HOST_DIR=/home/oaleksandrov/hls-cache

# Public URLs (baked into web/cms at build time AND used at runtime).
# Behind Caddy: HTTPS + domains. API is SAME-ORIGIN as the site (tapenetwork.de/api/*),
# so no CORS and no mixed-content. Streamer lives on its own subdomain.
PUBLIC_WEB_URL=https://tapenetwork.de
PUBLIC_API_URL=https://tapenetwork.de
PUBLIC_STREAMER_URL=https://video.tapenetwork.de
CORS_ALLOWED_ORIGINS=https://tapenetwork.de,https://cms.tapenetwork.de

# ACME contact e-mail for Let's Encrypt (expiry notices / account recovery).
ACME_EMAIL=admin@tapenetwork.de

# Database
POSTGRES_DB=tape
POSTGRES_USER=tape
POSTGRES_PASSWORD=CHANGE_ME

# Backend auth (>= 32 bytes)
JWT_SECRET=CHANGE_ME_32_BYTES_MIN
